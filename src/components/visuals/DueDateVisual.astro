---
/**
 * How often the due date is right.
 * The figures are the ones the page copy states (data/tools/due-date-calculator.ts,
 * citing ACOG): 4–5% of babies on the day, 80% within 10 days, 95% within 20 days.
 */
const HALF = 20;    // days drawn either side of the due date
const WIDE = 20;    // 95% of births fall within this many days
const NARROW = 10;  // 80% of births fall within this many days

const W = 440, H = 48, PAD = 20;
const UNIT = (W - 2 * PAD) / (2 * HALF);  // viewBox units per day
const x = (day: number) => PAD + (day + HALF) * UNIT;
const pct = (day: number) => `${((x(day) / W) * 100).toFixed(2)}%`;
---

<figure class="tool-visual">
  <p class="eyebrow tv-title">How often the date is right</p>

  <div class="row">
    <span class="due" style={`left:${pct(0)}`}>Due date: 4–5% born on the day</span>
  </div>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A band of days around the due date: a wide block for the 95% of births within 20 days, a narrower block for the 80% within 10 days, and a tick at the due date itself.">
    <line x1="0" y1={H / 2} x2={W} y2={H / 2} stroke="var(--color-line)" stroke-width="1.6" vector-effect="non-scaling-stroke" />
    <rect x={x(-WIDE)} y="12" width={x(WIDE) - x(-WIDE)} height="24" fill="var(--color-line)" />
    <rect x={x(-NARROW)} y="8" width={x(NARROW) - x(-NARROW)} height="32" fill="var(--color-accent-light)" stroke="var(--color-ink)" stroke-width="1.8" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
    <line x1={x(0)} y1="2" x2={x(0)} y2={H - 2} stroke="var(--color-accent)" stroke-width="2.2" stroke-linecap="round" vector-effect="non-scaling-stroke" />
  </svg>
  <div class="row">
    <span style={`left:${pct(-HALF)}`}>20 days early</span>
    <span style={`right:${pct(-HALF)}`}>20 days late</span>
  </div>

  <ul class="legend">
    <li><i class="sw narrow"></i>80% of births: within 10 days</li>
    <li><i class="sw wide"></i>95%: within 20 days</li>
  </ul>

  <figcaption>Where births fall around the estimated date: about 4 to 5 in 100 arrive on the day, 80% within 10 days and 95% within 20 days, the ACOG figures this page cites.</figcaption>
</figure>

<style>
  .tv-title { margin: 0 0 .9rem; font-size: .76rem; line-height: 1.4; }
  svg { overflow: visible; }
  .row { position: relative; height: 1.4rem; font-size: .8rem; color: var(--color-muted); }
  .row span { position: absolute; top: 0; line-height: 1.4rem; white-space: nowrap; }
  .row .due { transform: translateX(-50%); color: var(--color-accent); font-weight: 600; }
  .legend { list-style: none; display: flex; flex-wrap: wrap; gap: .35rem 1.4rem; margin: .8rem 0 0; padding: 0; font-size: .8rem; color: var(--color-muted); }
  .legend li { margin: 0; padding: 0; }
  .sw { display: inline-block; width: .85em; height: .85em; margin-right: .45em; vertical-align: -.08em; border: 1.6px solid var(--color-ink); }
  .sw.narrow { background: var(--color-accent-light); }
  .sw.wide { background: var(--color-line); border-color: transparent; }
</style>
