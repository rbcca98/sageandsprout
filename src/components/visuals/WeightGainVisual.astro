---
/**
 * Recommended total gain by pre-pregnancy BMI (IOM/NASEM 2009), read from
 * islands/weight-gain.ts by running the calculator once per category:
 * 5 ft 5 in at 102, 132, 162 and 192 lb lands on BMI 17, 22, 27 and 32.
 */
import { calculateWeightGain } from '../../islands/weight-gain';

const SAMPLE_LBS = [102, 132, 162, 192];
const rows = SAMPLE_LBS.map((lb) => {
  const r = calculateWeightGain({ heightFt: 5, heightIn: 5, weightLbs: lb, twins: false, gestWeeks: 20 })!;
  const [name, bmi] = r.bmiCategory.replace(')', '').split(' (');
  return { name, bmi, low: r.totalRangeLow, high: r.totalRangeHigh };
});

const AXIS_MAX = Math.ceil(Math.max(...rows.map((r) => r.high)) / 10) * 10;
const TICKS = Array.from({ length: AXIS_MAX / 10 + 1 }, (_, i) => i * 10);
const pct = (lb: number) => `${((lb / AXIS_MAX) * 100).toFixed(2)}%`;
---

<figure class="tool-visual">
  <p class="eyebrow tv-title">Recommended total gain, one baby</p>

  <div class="rows">
    {rows.map((r) => (
      <div class="row">
        <div class="head">
          <span class="name">{r.name}</span>
          <span class="sub">{r.bmi}</span>
          <span class="val">{r.low}–{r.high} lb</span>
        </div>
        <div class="track"><span class="bar" style={`left:${pct(r.low)};width:${pct(r.high - r.low)}`}></span></div>
      </div>
    ))}
  </div>
  <div class="axis" aria-hidden="true">
    {TICKS.map((t, i) => (
      <span class:list={{ first: i === 0, last: i === TICKS.length - 1 }} style={`left:${pct(t)}`}>{t}{i === TICKS.length - 1 ? ' lb' : ''}</span>
    ))}
  </div>

  <figcaption>Total weight gain the tool recommends for each pre-pregnancy BMI category, from the IOM/NASEM 2009 guideline it uses.</figcaption>
</figure>

<style>
  .tv-title { margin: 0 0 .9rem; font-size: .76rem; line-height: 1.4; }
  .rows { display: grid; gap: .75rem; }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .1rem .6rem; font-size: .82rem; line-height: 1.4; }
  .head .name { color: var(--color-ink); font-weight: 600; }
  .head .sub { color: var(--color-muted); }
  .head .val { margin-left: auto; color: var(--color-accent); font-weight: 600; font-variant-numeric: tabular-nums; }
  .track { position: relative; height: 14px; margin-top: .3rem; border-bottom: 1px solid var(--color-line); }
  .bar { position: absolute; top: 0; bottom: -1px; border: 1.8px solid var(--color-ink); }
  .axis { position: relative; height: 1.4rem; margin-top: .2rem; font-size: .78rem; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .axis span { position: absolute; top: 0; line-height: 1.4rem; white-space: nowrap; transform: translateX(-50%); }
  .axis span.first { transform: none; }
  .axis span.last { transform: translateX(-100%); }
</style>
