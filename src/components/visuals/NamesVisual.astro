---
/**
 * How many of the explorer's top-100 boy and top-100 girl names start with
 * each letter, counted at build time from data/baby-names.ts.
 */
import { BABY_NAMES } from '../../data/baby-names';

const counts = new Map<string, number>();
for (const { name } of BABY_NAMES) counts.set(name[0], (counts.get(name[0]) ?? 0) + 1);
const letters = [...counts.entries()]
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([letter, n]) => ({ letter, n }));
const MAX = Math.max(...letters.map((l) => l.n));
const [first, second] = [...letters].sort((a, b) => b.n - a.n);

const BAR_PX = 96;  // height of the tallest bar
const summary = letters.map((l) => `${l.letter} ${l.n}`).join(', ');
---

<figure class="tool-visual">
  <p class="eyebrow tv-title">{first.letter} leads with {first.n} names, then {second.letter} with {second.n}</p>

  <div class="strip" role="img" aria-label={`Bars for the first letter of ${BABY_NAMES.length} names: ${summary}.`} style={`grid-template-columns:repeat(${letters.length}, minmax(0, 1fr))`}>
    {letters.map((l) => (
      <div class="col">
        <span class:list={['bar', { top: l.n === MAX }]} style={`height:${Math.max(4, Math.round((l.n / MAX) * BAR_PX))}px`}></span>
        <span class="ltr">{l.letter}</span>
      </div>
    ))}
  </div>

  <figcaption>Top 100 boy and girl names by first letter, from the SSA list the explorer uses.</figcaption>
</figure>

<style>
  .tv-title { margin: 0 0 .9rem; font-size: .76rem; line-height: 1.4; }
  .strip { display: grid; align-items: end; }
  .col { display: flex; flex-direction: column; align-items: center; }
  .bar { display: block; width: 62%; min-width: 4px; border: 1.8px solid var(--color-ink); }
  .bar.top { background: var(--color-accent-light); }
  .ltr { width: 100%; padding-top: .3rem; border-top: 1.6px solid var(--color-line); text-align: center; font-size: .78rem; line-height: 1.3; color: var(--color-muted); }
</style>
